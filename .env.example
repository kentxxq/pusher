# 数据库：mysql 或 sqlite
DB_DIALECT=mysql
DATABASE_URL=mysql://fake_user:fake_password@REPLACE_ME:3306/REPLACE_ME
SQLITE_PATH=./data/pusher.sqlite

# 对外访问地址；用于 Cookie 和 Action 来源检查。此处填写浏览器访问的 HTTPS 地址，如 https://REPLACE_ME
APP_URL=http://localhost:3000
PORT=3000
HOST=0.0.0.0

# 沿用旧版 JWT 配置；密钥为至少 32 字节的 Base64 字符串
JWT_KEY=fake_key
JWT_ISSUER=REPLACE_ME
JWT_AUDIENCE=REPLACE_ME
JWT_EXPIRE_DAYS=1

# 首次初始化使用；已有账号不会被覆盖
ADMIN_USERNAME=fake_email
ADMIN_PASSWORD=fake_password

# 邮件服务；注册、找回密码和邮箱管道使用
SMTP_HOST=REPLACE_ME
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=fake_user
SMTP_PASSWORD=fake_password
SMTP_FROM=fake_email

TASK_TIMEZONE=Asia/Shanghai
# 消息保留天数，默认 30，须为非负整数；每天凌晨 2 点（TASK_TIMEZONE）清理超期消息及推送历史
MESSAGE_RETENTION_DAYS=30
# 演示账号用户名；每天凌晨 2 点（TASK_TIMEZONE）删除其房间、渠道、模板及关联并重建示例数据
# 不会创建账号；账号不存在或为管理员时跳过；留空仍使用 test，请勿填写普通业务账号
DEMO_USERNAME=test

# Taskfile 部署连接；REMOTE_TARGET 指向远端应用目录
REMOTE_USER=fake_user
REMOTE_HOST=fake_url
REMOTE_TARGET=/REPLACE_ME/pusher
