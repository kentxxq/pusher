{
  "name": "pusher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^24.22.0 || >=26.12.0"
  },
  "scripts": {
    "dev": "vite",
    "prepare:types": "void prepare",
    "typecheck": "void prepare && vue-tsc --noEmit",
    "build": "vite build",
    "start": "tsx scripts/start.ts",
    "db:generate": "drizzle-kit generate --config drizzle.mysql.config.ts && drizzle-kit generate --config drizzle.sqlite.config.ts",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:baseline": "tsx scripts/database.ts baseline",
    "db:check": "tsx scripts/check-migrations.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@nuxt/ui": "^4.12.0",
    "@void/vue": "1.5.0",
    "better-sqlite3": "12.11.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "echarts": "^5.6.0",
    "handlebars": "^4.7.10",
    "hono": "^4.13.16",
    "jose": "^6.2.13",
    "jsonc-parser": "^3.3.1",
    "jsonpath-rfc9535": "^1.3.0",
    "mysql2": "^3.24.6",
    "node-cron": "^4.6.0",
    "nodemailer": "^7.0.13",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "undici": "^7.30.1",
    "void": "1.5.0",
    "vue": "^3.5.44",
    "vue-echarts": "^7.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^7.0.12",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "workerd",
      "@parcel/watcher"
    ],
    "overrides": {
      "better-sqlite3": "12.11.1"
    }
  }
}
